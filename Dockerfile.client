FROM ubuntu:24.04
RUN apt update && apt install -y python3 python3-pip
WORKDIR /app
COPY proto/ proto/
COPY client_python/ client_python/
RUN pip3 install --break-system-packages -r client_python/requirements.txt
RUN python3 -m grpc_tools.protoc -Iproto --python_out=client_python \
    --grpc_python_out=client_python proto/file_processor.proto
CMD sleep infinity
